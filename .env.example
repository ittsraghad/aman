# Export these in your shell (never commit real keys).
GEMINI_API_KEY=                 # https://aistudio.google.com  (free tier)
AMAN_LLM=auto                   # auto | gemini | claude | extractive
AMAN_GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite   # run scripts/check_providers.py to see valid names
AMAN_EMBEDDER=auto              # auto | gemini | st | hash
AMAN_GEMINI_EMBED_MODEL=gemini-embedding-001
AMAN_EMBED_DIM=768
ANTHROPIC_API_KEY=              # optional alternative LLM
AMAN_NO_BUILD=0                 # 1 in production: use prebuilt vectors only
AMAN_RATE_PER_MIN=12            # chat requests per IP per minute
AMAN_DAILY_LLM_CAP=1000         # LLM calls per day, then falls back to extractive answers
AMAN_TRUST_PROXY=0              # 1 behind Render
AMAN_AUTHOR=
AMAN_LINKEDIN=
AMAN_GITHUB=
NVD_API_KEY=                    # faster NVD downloads
